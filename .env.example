# Gemini requests must go through the backend. Never put this in frontend/VITE_ variables.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Google Maps browser key: restrict to the intended site origins in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=

PORT=3001
