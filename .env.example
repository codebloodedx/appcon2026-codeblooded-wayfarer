# Gemini requests use this server-only API key first. Do not put it in Vercel
# or any VITE_ variable. If omitted, the backend falls back to Vertex AI ADC.
GEMINI_API_KEY=

# Vertex AI fallback for local development or workload identity federation.
# Run: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite

# Google Maps browser key: restrict to the intended site origins in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=

PORT=3001
